# ---------------------------------------------------------------
# The studio is for this computer only. Keeping these out of the
# repository is what guarantees they are never deployed with the
# site — Cloudflare Pages publishes whatever is in the repo.
#
# They stay on your disk; git simply stops tracking them.
# ---------------------------------------------------------------
# The studio now lives at studio/index.html and IS part of the site,
# served at /studio/ behind the sign-in. Only these stay local.
studio.py
preview.bat

# python leftovers
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/

# raw, unresized photos — keep these out of the repo
photos/**/raw/
*.HEIC
*.heic

# the full-size client videos, kept on your computer only.
# The compressed ones sitting next to them are what the site uses.
photos/clients/_originals/

# the studio's trash. Deleted pieces wait here on your computer
# until you empty it — they never reach the website.
photos/_trash/

# the local test database made by dev.mjs. Never pushed.
.qala-dev.sqlite

# the studio's and this session's leftovers on your computer. Old copies
# and update bundles wait here until you delete the folder yourself.
_to_delete/

# sqlite writes a journal beside the database while it is open
.qala-dev.sqlite*
